# ============================================================
# Coinremitter Credentials
# ============================================================
# Wallet API Key from the Coinremitter dashboard
COINREMITTER_API_KEY=your_wallet_api_key_here

# Wallet Password — this is the password set in the Coinremitter
# wallet settings, NOT your account login password.
# If you get "invalid credentials", double-check this value.
COINREMITTER_PASSWORD=your_wallet_password_here

# ============================================================
# Convex
# ============================================================
# Convex Cloud URL (deployment)
CONVEX_URL=https://tame-poodle-465.convex.cloud

# Convex HTTP Action URL (used for webhook notify_url)
CONVEX_SITE_URL=https://tame-poodle-465.convex.site

# ============================================================
# Express Server (optional, for local / fallback webhook)
# ============================================================
PORT=3000
